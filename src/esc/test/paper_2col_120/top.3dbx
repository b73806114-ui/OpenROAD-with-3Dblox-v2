Header:
  version: "1.0"
  unit: "micron"
  precision: 2000
  include:
    - die.3dbv
    - substrate.3dbv
Design:
  name: "EscapeRouting_120"
  external:
    verilog_file: [top.v]
ChipletInst:
  die_inst:
    reference: DieChiplet
  substrate_inst:
    reference: SubChiplet
Stack:
  die_inst:
    loc: [0.0, 0.0]
    z: 116.0
    orient: R0
  substrate_inst:
    loc: [-880, -160]
    z: 0.0
    orient: R0
Connection:
  die_to_substrate:
    top: die_inst.regions.bond_region
    bot: substrate_inst.regions.bond_region
    thickness: 26.0
