# Substrate chiplet – 3-region
Header:
  version: "1.0"
  unit: "micron"
  precision: 2000
ChipletDef:
  SubChiplet:
    type: substrate
    design_area: [4200, 3000]
    thickness: 90.0
    regions:
      top_bond_bump_region:
        side: front
        bmap: top_bond_bumps.bmap
        coords:
          - [1460.0, 1040.0]
          - [2180.0, 1040.0]
          - [2180.0, 2080.0]
          - [1460.0, 2080.0]
      top_rdl_pad_region:
        side: front
        bmap: top_rdl_pads.bmap
        coords:
          - [3460.0, -120.0]
          - [4180.0, -120.0]
          - [4180.0, 920.0]
          - [3460.0, 920.0]
      rdl_bump_region:
        side: back
        bmap: substrate_bumps.bmap
        coords:
          - [466.0, -180.0]
          - [4866.0, -180.0]
          - [4866.0, 920.0]
          - [466.0, 920.0]
    external:
      APR_tech_file:
        - ../../../../test/Nangate45/Nangate45_tech.lef
      LEF_file:
        - ../../../../test/Nangate45/fake_bumps.lef
