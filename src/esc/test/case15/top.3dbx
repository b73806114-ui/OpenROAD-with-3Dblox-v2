Header:
  version: "1.0"
  unit: "micron"
  precision: 2000
  include:
    - die.3dbv
    - substrate.3dbv
Design:
  name: "EscapeRouting_15"
ChipletInst:
  die_inst:
    reference: DieChiplet
  substrate_inst:
    reference: SubChiplet
Stack:
  die_inst:
    loc: [0.0, 0.0]
    z: 116.0
    orient: R0
  substrate_inst:
    loc: [-1660, -1160]
    z: 0.0
    orient: R0
Connection:
  die_to_substrate:
    top: die_inst.regions.bond_region
    bot: substrate_inst.regions.top_bond_bump_region
    thickness: 26.0
  substrate_to_package:
    top: substrate_inst.regions.rdl_bump_region
    bot: "~"
    thickness: 0.0
