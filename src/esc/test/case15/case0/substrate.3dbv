# 3DBlox Chiplet Definition – Substrate chiplet
# Generated from try_routing case

Header:
  version: "1.0"
  unit: "micron"
  precision: 2000

ChipletDef:
  SubChiplet:
    type: substrate
    design_area: [4000.0, 3000.0]
    thickness: 90.0
    regions:
      top_bond_bump_region:
        side: front
        bmap: top_bond_bumps.bmap
        coords:
          # Die bond_region in this substrate's local coordinates.
          - [1480.0, 1140.0]
          - [2160.0, 1140.0]
          - [2160.0, 1820.0]
          - [1480.0, 1820.0]
      top_rdl_pad_region:
        side: front
        bmap: top_rdl_pads.bmap
        coords:
          - [3400.0, 800.0]
          - [4000.0, 800.0]
          - [4000.0, 1800.0]
          - [3400.0, 1800.0]
      rdl_bump_region:
        side: back
        bmap: substrate_bumps.bmap
        coords:
          - [0.0, 0.0]
          - [4000.0, 0.0]
          - [4000.0, 3000.0]
          - [0.0, 3000.0]
    external:
      APR_tech_file:
        - ../../../../test/Nangate45/Nangate45_tech.lef
      LEF_file:
        - ../../../../test/Nangate45/fake_bumps.lef
