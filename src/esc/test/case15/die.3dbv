# Die chiplet – 15 micro-bumps
Header:
  version: "1.0"
  unit: "micron"
  precision: 2000
ChipletDef:
  DieChiplet:
    type: die
    design_area: [680.0, 1080]
    thickness: 90.0
    regions:
      bond_region:
        side: back
        bmap: die_bumps.bmap
        coords:
          - [-200.0, -120.0]
          - [520.0, -120.0]
          - [500.0, 1100]
          - [-180.0, 1100]
    external:
      APR_tech_file:
        - ../../../../test/Nangate45/Nangate45_tech.lef
      LEF_file:
        - ../../../../test/Nangate45/fake_bumps.lef
